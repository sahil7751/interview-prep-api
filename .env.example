# Copy this file to .env and fill in real values for your environment.
# .env is git-ignored — never commit real secrets.

# ── Database ────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=job_tracker_db
MYSQL_USER=jobtracker
MYSQL_PASSWORD=replace_with_a_strong_password
# Only used by the standalone MySQL container in docker-compose.yml
MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password

# ── JWT ─────────────────────────────────────────────────────────
# Required. Use a long, random, unpredictable string (32+ characters).
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=86400000

# ── Groq AI API ─────────────────────────────────────────────────
# Required. Get a key from https://console.groq.com
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.3-70b-versatile

# ── CORS ────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev default: http://localhost:3000
# Production: set to your deployed frontend URL(s), e.g.
# https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Server ──────────────────────────────────────────────────────
SERVER_PORT=8081
